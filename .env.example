# OG-AI Agent Configuration
# Copy this file to .env and add your actual API keys

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama Configuration (for local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Default AI Provider (openai, anthropic, or ollama)
AI_PROVIDER=openai

# Web Search Configuration
SERPAPI_KEY=your_serpapi_key_here
BRAVE_SEARCH_API_KEY=your_brave_search_key_here

# OG Web Lookup (Round 3) — uses OPENAI_API_KEY via the Responses API
# web_search tool; no extra key needed. OG_SEARCH_API_KEY optionally adds
# a Tavily fallback; OG_LOOKUP_DAILY_LIMIT caps lookups per visitor/day.
OG_SEARCH_MODEL=gpt-4o-mini
OG_SEARCH_API_KEY=
OG_LOOKUP_DAILY_LIMIT=25

# Google Account Connect (Round 3, ships dark) — set all three to enable.
# Create the OAuth client in Google Cloud Console (Web application) with
# authorized redirect URI:
#   https://og-ai-service.onrender.com/auth/google/callback
OG_GOOGLE_ENABLED=false
OG_GOOGLE_CLIENT_ID=
OG_GOOGLE_CLIENT_SECRET=
OG_GOOGLE_REDIRECT_URI=https://og-ai-service.onrender.com/auth/google/callback

# Free Tier (Round 2; default raised 10,000 -> 25,000 in Round 4) — free
# visitors get this many model tokens per UTC day. The env override
# wins; OG_FREE_DAILY_LIMIT is still honored as a legacy alias.
OG_FREE_DAILY_TOKENS=25000

# Live Data Pack (Round 4) — weather, sports scores, stock & crypto
# quotes and news headlines from keyless public endpoints (Open-Meteo,
# ESPN, Nasdaq/Yahoo, Coinbase/CoinGecko, Google News RSS). No keys or
# config needed; data questions share the Round 3 lookup budget above.

# Image Generation (Round 5) — uses OPENAI_API_KEY (OpenAI Images API);
# OG_IMAGE_MODEL is tried first and dall-e-3 is the automatic fallback.
# Images cost real cents each, so per-visitor daily caps guard the key.
OG_IMAGE_MODEL=gpt-image-1
OG_IMAGE_FREE_DAILY=2
OG_IMAGE_PRO_DAILY=25

# File Reading (Round 6) — visitors attach ONE file (PDF/TXT/PNG/JPG/
# WEBP, 8 MB max) and ask OG about it. Stored per-visitor on local disk
# (OG_UPLOAD_DIR), kept at most 24h, never shared across visitors.
# Photos are read by a vision call on OPENAI_API_KEY (OG_VISION_MODEL)
# only when the visitor asks about the photo. Daily upload caps:
OG_UPLOAD_FREE_DAILY=3
OG_UPLOAD_PRO_DAILY=30
OG_VISION_MODEL=gpt-4o-mini

# Voice Notes (Round 8) — visitors record a clip in the browser and
# POST /transcribe turns it into text on OPENAI_API_KEY; the page then
# sends the transcript through /chat like typed text. Audio is never
# stored. OG_TRANSCRIBE_MODEL pins one model; unset, the app prefers
# gpt-4o-mini-transcribe and falls back to whisper-1 automatically.
# Daily caps are per-tier (Round 7 table): free 3, standard 15,
# pro 50, blue 150, blackout 500 — override with OG_CAP_<TIER>_TRANSCRIBE.
# OG_TRANSCRIBE_MODEL=whisper-1

# Maps & Places (Round 9) — place + route answers from the keyless
# OpenStreetMap stack (Nominatim geocoding, Overpass nearby search,
# OSRM driving routes). No keys or config needed; answers share the
# Round 3 lookup budget above. OG_OVERPASS_URLS optionally repoints
# the Overpass endpoint pair (comma-separated, primary + mirror).
# OG_OVERPASS_URLS=https://overpass.openstreetmap.fr/api/interpreter,https://overpass.kumi.systems/api/interpreter

# Agent Personality Settings
AGENT_PERSONALITY=sassy
SWEARING_ENABLED=true
GHETTO_MODE=true
SMART_ASS_LEVEL=high

# Code Execution Settings
ENABLE_CODE_EXECUTION=true
ALLOWED_LANGUAGES=python,javascript,bash

# Server Configuration
PORT=8000
DEVELOPMENT_MODE=true

# --- Pricing tiers (Round 7 ladder) -----------------------------------------
# Four paid tiers replaced the single $9.99 plan. /pro serves the
# ladder page; each card's Stripe payment link redirects back to
# /pro/success?tier=<tier>, which sets the ogai_tier cookie
# ("<tier>.<token>", token = OG_TIER_TOKEN or legacy OG_PRO_TOKEN).
# Legacy ogai_pro cookie holders ride as standard tier.
# OG_TIER_TOKEN=          # optional dedicated cookie token
# OG_PUBLIC_URL=https://og-ai-service.onrender.com   # base for in-chat upgrade links
# Checkout links (defaults are the live Stripe links created 2026-10-08;
# they win over the legacy OG_PRO_LINK, which is no longer linked):
# OG_LINK_STANDARD=https://buy.stripe.com/00wfZi8GB3kHaLEft4dby04
# OG_LINK_PRO=https://buy.stripe.com/00wcN63mh2gD4ng6Wydby05
# OG_LINK_BLUE=https://buy.stripe.com/3cIeVeg936wT9HAbcOdby06
# OG_LINK_BLACKOUT=https://buy.stripe.com/6oU9AUf4Zg7t6vo94Gdby07
# Per-tier daily caps (defaults shown; kind = images/uploads/lookup/tts/upload_mb):
# OG_CAP_STANDARD_IMAGES=10  OG_CAP_PRO_IMAGES=50  OG_CAP_BLUE_IMAGES=300  OG_CAP_BLACKOUT_IMAGES=1000
# OG_CAP_STANDARD_UPLOADS=25 OG_CAP_PRO_UPLOADS=30 OG_CAP_BLUE_UPLOADS=100 OG_CAP_BLACKOUT_UPLOADS=300
# OG_CAP_STANDARD_LOOKUP=250 OG_CAP_PRO_LOOKUP=250 OG_CAP_BLUE_LOOKUP=250  OG_CAP_BLACKOUT_LOOKUP=1000
# OG_CAP_STANDARD_TTS=60     OG_CAP_PRO_TTS=300    OG_CAP_BLUE_TTS=600     OG_CAP_BLACKOUT_TTS=2000
# OG_CAP_FREE_TRANSCRIBE=3   OG_CAP_STANDARD_TRANSCRIBE=15 OG_CAP_PRO_TRANSCRIBE=50 OG_CAP_BLUE_TRANSCRIBE=150 OG_CAP_BLACKOUT_TRANSCRIBE=500
# OG_CAP_PRO_UPLOAD_MB=25 (free/standard stay 8)
# Webhook (v2, dark) tier mapping — price id -> tier, read from the
# checkout session's metadata.tier (set on the payment links above):
#   price_1UOJxjJgRg4PhjAqIBzwLEoo standard | price_1UOJxtJgRg4PhjAqKFUAuzKz pro
#   price_1UOJy0JgRg4PhjAqAJ5PXD2g blue     | price_1UOJy8JgRg4PhjAq5uCiCfSu blackout
#   price_1UMaXZJgRg4PhjAqsEJqmSeA (legacy $9.99) -> standard
